#!/usr/bin/env python3
"""Count attempted, successful, failed and unknown tool evidence in bounded histories.

Counts describe recorded tool evidence. They do not prove rule compliance.
"""

import argparse
import collections
import json
import re
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from agent_history import AGENTS, add_history_arguments, scope_from_args

# label -> (rule file, matcher). A matcher is a tool name, a tool-name prefix
# ending in *, or a /regex/ tested against Bash command text.
CHECKS = [
    ("ctx7 docs lookup",        "context7.md",       "/\\bctx7\\b/"),
    ("  vs WebFetch/WebSearch", "context7.md",       "WebFetch|WebSearch"),
    ("plannotator review",      "plannotator.md",    "/\\bplannotator\\b/"),
    ("portless named URLs",     "portless.md",       "/\\bportless\\b/"),
    ("  vs banned pkill",       "portless.md",       "/\\bpkill\\b|\\bkillall\\b|kill \\$\\(lsof/"),
    ("agent-browser",           "ui-verification.md","/\\bagent-browser\\b/"),
    ("agent-desktop",           "ui-verification.md","/\\bagent-desktop\\b/"),
    ("argent (all)",            "argent.md",         "mcp__argent__*"),
    ("agentation",              "agentation.md",     "mcp__agentation__*"),
    ("BLANK discovery",         "direction-first.md",r"/direction_discover|/direction/discover|/registry/search|registry_search|\bblank\s+(?:search|registry-search)\b/"),
    ("  + other BLANK lookups", "direction-first.md","mcp__blank-direction__*"),
    ("anydoc",                  "anydoc.md",         "/anydoc/"),
    ("Monitor / await",         "waiting.md",        "Monitor|mcp__argent__await-*"),
    ("  vs raw sleep polling",  "waiting.md",        "/\\bsleep \\d/"),
    ("Skill invocations",       "(harness)",         "Skill"),
]


def matches_tool(matcher, event):
    """Match normalized tool name/arguments privately, not exported tool contents."""
    if matcher.startswith('/') and matcher.endswith('/'):
        return bool(re.search(matcher[1:-1], event.name + ' ' + event.text, re.I))
    return any(event.name.startswith(alt[:-1]) if alt.endswith('*') else event.name == alt
               for alt in matcher.split('|'))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    add_history_arguments(parser)
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    scope = scope_from_args(parser, args)
    counts = {agent: {label: collections.Counter() for label, _, _ in CHECKS} for agent in AGENTS}
    totals = {agent: collections.Counter() for agent in AGENTS}
    for agent, _, _, events in scope.sessions():
        for event in events:
            if event.kind != 'tool':
                continue
            totals[agent][event.outcome] += 1
            for label, _, matcher in CHECKS:
                if matches_tool(matcher, event):
                    counts[agent][label]['attempted'] += 1
                    counts[agent][label][event.outcome] += 1
    report = {'metadata': scope.metadata(), 'totals': totals,
              'checks': [{'behaviour': label, 'rule': rule,
                          'agents': {agent: {state: counts[agent][label][state] for state in ('attempted', 'success', 'failed', 'unknown')} for agent in AGENTS}}
                         for label, rule, _ in CHECKS]}
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        for agent in AGENTS:
            print(f'{agent}: {sum(totals[agent].values())} recorded calls')
            print(f"{'behaviour':26} {'attempt':>8} {'success':>8} {'failed':>8} {'unknown':>8}")
            for row in report['checks']:
                data = row['agents'][agent]
                print(f"{row['behaviour']:26}" + ''.join(f'{data[state]:9}' for state in ('attempted', 'success', 'failed', 'unknown')))
        print(json.dumps(report['metadata']))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
