#!/usr/bin/env python3
"""Find candidate tasks in bounded agent histories. Export metadata, never contents.

Automated fields are leads for human review, not claims of skill compliance.
"""
import argparse
import json
import re
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from agent_history import add_history_arguments, scope_from_args

OPEN_CHOICE = re.compile(r'\b(build|create|design|redesign|restyle|make|new|choose|pick)\b', re.I)
UI_OR_TOOL = re.compile(r'\b(page|component|ui|site|website|dashboard|landing|hero|visual|animation|motion|interface|layout|library|tool|backend|rate limit|job queue|auth)\b', re.I)
FIXED = re.compile(r'\b(fix|bug|broken|error|typo|spacing|change (?:the )?color|copy this|1:1|exact same)\b', re.I)
CORRECTION = re.compile(r"\b(nope|wrong|not what|didn't|did not|still the same|hate|does not work|doesn't work|fix this|why haven't)\b", re.I)
DISCOVERY = re.compile(r'direction_discover|/direction/discover|/registry/search|registry_search|\bblank\s+(?:search|registry-search)\b', re.I)
INSPECTION = re.compile(r'inspiration_inspect|\bblank\s+source\b|https?://', re.I)
RUNTIME = re.compile(r'agent-browser .*?(?:open|snapshot|screenshot|click)|argent.*(?:describe|screenshot|gesture)|(?:pnpm|npm|bun|pytest|python3).*?test|screenshot-diff', re.I)
EDIT = re.compile(r'(?:\bwrite\b|\bedit\b|apply_patch|search_replace|plannotator annotate)', re.I)


def candidate_tasks(events, agent, session, project_id):
    """Completion is explicit; unknown and failed calls never become successful evidence."""
    current = None
    for event in events:
        if event.kind in ('user', 'boundary'):
            if current:
                if event.kind == 'user':
                    current['correction_followup'] = bool(CORRECTION.search(event.text))
                yield current
            current = None
            if event.kind != 'user':
                continue
            text = event.text
            if (not OPEN_CHOICE.search(text) or not UI_OR_TOOL.search(text) or FIXED.search(text)
                    or text.lstrip().startswith(('<', '[Request interrupted', 'Base directory for this skill:', '# Files mentioned by the user:'))):
                continue
            current = {'agent': agent, 'date': event.timestamp[:10], 'sort_time': event.timestamp,
                       'session_id': session, 'project_id': project_id, 'event': event.ordinal,
                       'complete': False, 'discovery_before_choice': False, 'discovery_attempted': False,
                       'discovery_failed': False, 'source_inspected_candidate': False,
                       'runtime_check_candidate': False, 'correction_followup': None,
                       'unknown_tool_calls': 0, 'failed_tool_calls': 0, 'choice_started': False,
                       'unknown': True}
        elif current and event.kind == 'tool':
            current['complete'] = False
            text = event.name + ' ' + event.text
            if event.outcome == 'unknown':
                current['unknown_tool_calls'] += 1
            elif event.outcome == 'failed':
                current['failed_tool_calls'] += 1
            discovery = bool(DISCOVERY.search(text))
            if discovery:
                current['discovery_attempted'] = True
                current['discovery_failed'] |= event.outcome == 'failed'
                if not current['choice_started'] and event.outcome == 'success':
                    current['discovery_before_choice'] = True
            if event.outcome == 'success':
                if INSPECTION.search(text) and not discovery:
                    current['source_inspected_candidate'] = True
                if RUNTIME.search(text):
                    current['runtime_check_candidate'] = True
            # Even an attempted edit starts a choice, regardless of its outcome.
            if EDIT.search(text):
                current['choice_started'] = True
        elif current and event.kind == 'final':
            current['complete'] = True
    if current:
        yield current


def gather(scope):
    """Gather only the explicitly selected scope and window."""
    for agent, session, project, events in scope.sessions():
        yield from candidate_tasks(events, agent, session, project)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    add_history_arguments(parser)
    parser.add_argument('--limit', type=int, default=20)
    parser.add_argument('--include-incomplete', action='store_true')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    if args.limit < 1:
        parser.error('--limit must be positive')
    scope = scope_from_args(parser, args)
    candidates = list(gather(scope))
    rows = [row for row in candidates if row['complete'] or args.include_incomplete]
    rows.sort(key=lambda row: (row['sort_time'], row['session_id'], row['event']), reverse=True)
    rows = rows[:args.limit]
    for row in rows:
        row.pop('choice_started')
        row.pop('sort_time')
    report = {'metadata': scope.metadata(), 'count': len(rows),
              'incomplete_candidates': sum(not row['complete'] for row in candidates), 'rows': rows}
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"{len(rows)} candidate tasks; {report['incomplete_candidates']} incomplete. Human review required.")
        for row in rows:
            print(f"{row['date']} {row['agent']:6} {row['session_id']} event {row['event']} complete={row['complete']} discovery-before-edit={row['discovery_before_choice']} failed-tools={row['failed_tool_calls']} unknown-tools={row['unknown_tool_calls']}")
        print(json.dumps(report['metadata']))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
