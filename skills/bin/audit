#!/usr/bin/env python3
"""Measure prompt signals in bounded Codex, Claude and Pi histories.

Raw prompts stay in memory. --corpus exports signal metadata only.
"""

import argparse
import collections
import json
import re
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from agent_history import AGENTS, add_history_arguments, scope_from_args

SIGNALS = {
    "correction and pushback": r"\b(no+|nope|wrong|not what|actually|revert|undo|stop|dont|don't|instead|i said)\b",
    "verification asks": r"\b(check|verify|test|make sure|confirm|run it|screenshot)\b",
    "scope control": r"\b(only|just|dont (add|change|touch)|leave|keep it|minimal|nothing else)\b",
    "explanation asks": r"\b(why|explain|how does|walk me)\b",
    "aesthetic judgment": r"\b(ugly|pretty|prettier|beautiful|clean|aesthetic|vibe|polish|design)\b",
    "planning": r"\b(plan|approach|options|think about|before you)\b",
    "delegation": r"\b(agent|subagent|parallel|background|worker|spawn|delegate)\b",
}

BEHAVIOURS = {
    "pastes an image": r"\[Image #|codex-clipboard-.*\.png|<image name=",
    "pastes a URL": r"https?://",
    "asks for 1:1 or exact": r"\b(1:1|exactly|exact same|line by line|pixel|identical|same as)\b",
    "push or commit": r"\b(push|commit|pr\b|merge)\b",
    "deploy": r"\b(deploy|vercel|production|ship it|live)\b",
    "names another agent": r"\b(claude|codex|pi|cursor|gemini)\b",
    "design or UI work": r"\b(component|page|layout|css|animation|font|color|design|ui\b)\b",
}


def collect(scope):
    """Compute signal counts immediately; do not retain prompt text in corpus rows."""
    rows = []
    for agent, session, project, events in scope.sessions():
        for event in events:
            text = event.text.strip()
            if event.kind != 'user' or not text or text.startswith(('<environment_context>', '<user_instructions>', '<system-reminder>', 'Caveat:', 'Base directory for this skill:', '[Request interrupted')):
                continue
            rows.append({'agent': agent, 'ts': event.timestamp, 'session_id': session,
                         'project_id': project, 'event': event.ordinal, 'chars': len(text),
                         'signals': {name: len(re.findall(pattern, text, re.I)) for name, pattern in SIGNALS.items()},
                         'behaviours': {name: bool(re.search(pattern, text, re.I)) for name, pattern in BEHAVIOURS.items()}})
    return rows


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    add_history_arguments(parser)
    parser.add_argument('--corpus', type=Path, help='Write metadata-only JSONL, never raw prompts')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    scope = scope_from_args(parser, args)
    rows = collect(scope)
    counts = collections.Counter(row['agent'] for row in rows)
    chars = {agent: sum(row['chars'] for row in rows if row['agent'] == agent) or 1 for agent in AGENTS}
    report = {'metadata': scope.metadata(), 'count': len(rows),
              'agents': {agent: {'prompts': counts[agent],
                                 'median_chars': (sorted(row['chars'] for row in rows if row['agent'] == agent) or [0])[counts[agent] // 2],
                                 'signals_per_10000_chars': {name: sum(row['signals'][name] for row in rows if row['agent'] == agent) / chars[agent] * 10000 for name in SIGNALS}}
                         for agent in AGENTS},
              'behaviours': {name: sum(row['behaviours'][name] for row in rows) for name in BEHAVIOURS}}
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f'corpus: {len(rows)} prompts in selected scope')
        for agent, data in report['agents'].items():
            print(f"{agent:8} {data['prompts']:6} prompts; median {data['median_chars']} chars")
            for name, rate in data['signals_per_10000_chars'].items():
                print(f'  {name:26} {rate:.1f}')
        print(json.dumps(report['metadata']))
    if args.corpus:
        # Owner-only create; refuse existing files/symlinks rather than overwrite them.
        import os
        fd = os.open(args.corpus, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as output:
            for row in rows:
                output.write(json.dumps(row) + '\n')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
