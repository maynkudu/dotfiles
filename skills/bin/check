#!/usr/bin/env python3
"""Check source/build integrity, and optionally the installed active agents."""
import argparse
import json
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--repo-only', action='store_true', help='Check a fresh checkout without installed agents')
parser.add_argument('--home', type=Path, default=Path.home())
args = parser.parse_args()
cfg = tomllib.loads((ROOT.parent / 'setup.toml').read_text())
fails = []


def check(label, ok):
    print(f"{'ok  ' if ok else 'FAIL'} {label}")
    if not ok:
        fails.append(label)


result = subprocess.run([sys.executable, ROOT / 'bin/build', '--check'], capture_output=True, text=True)
check('generated rules match sources and fit budgets', result.returncode == 0)
if result.returncode:
    print(result.stdout, result.stderr)
for source in (ROOT / 'rules').rglob('*.md'):
    check(f'portable rule {source.relative_to(ROOT)}', '/Users/blank' not in source.read_text())
for name in cfg['skills']['local']:
    source = ROOT / 'skills' / name / 'SKILL.md'
    check(f'local skill {name}', source.is_file() and source.read_text().startswith('---'))
lock = json.loads((ROOT / 'sources.lock.json').read_text())
for source in lock['sources']:
    check(f"pinned source {source['repo']}", len(source['ref']) == 40)
if not args.repo_only:
    home = args.home.expanduser().resolve()
    targets = {'codex': home / '.codex/AGENTS.md', 'grok': home / '.grok/AGENTS.md',
               'pi': home / '.pi/agent/AGENTS.md', 'opencode': home / '.config/opencode/AGENTS.md'}
    for agent in cfg['agents']:
        if agent == 'claude':
            for source in (ROOT / 'build/claude/rules').glob('*.md'):
                dest = home / '.claude/rules' / source.name
                check(f'installed Claude rule {source.name}', dest.is_file() and dest.read_text() == source.read_text())
        else:
            dest = targets[agent]
            source = ROOT / 'build' / agent / 'AGENTS.md'
            check(f'installed {agent} rules', dest.is_file() and dest.read_text() == source.read_text())
    for name in cfg['skills']['local']:
        check(f'installed local skill {name}', (home / '.agents/skills' / name / 'SKILL.md').is_file())
    for source in lock['sources']:
        for entry in source['skills']:
            check(f"installed public skill {entry['name']}", (home / '.agents/skills' / entry['name'] / 'SKILL.md').is_file())
print(f'{len(fails)} failed.' if fails else 'All checks passed.')
raise SystemExit(bool(fails))
