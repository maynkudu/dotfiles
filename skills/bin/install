#!/usr/bin/env python3
"""Put build/ onto disk. Reads build/, never rules/.

    bin/install           install rules for the agents selected in setup.toml
    bin/install --dry-run show what would change, touch nothing

Claude gets one symlink per rule, because ~/.claude/rules/ also holds
machine-local rules and a directory symlink would hide them. Only symlinks
pointing into this repo are ever removed; anything else there is left alone.

Selected single-file agents get their whole AGENTS.md replaced when it differs.
Each replacement saves a timestamped .before-dotfiles- backup.
"""

import os
import shutil
import sys
import argparse
import tomllib
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build"
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--dry-run', action='store_true')
parser.add_argument('--agents', nargs='+', choices=['codex', 'claude', 'grok', 'pi', 'opencode'])
parser.add_argument('--home', type=Path, default=Path.home(), help='Target home, also useful for isolated verification')
args = parser.parse_args()
HOME = args.home.expanduser().resolve()

TARGETS = {
    "claude": HOME / ".claude" / "rules",
    "codex": HOME / ".codex" / "AGENTS.md",
    "grok": HOME / ".grok" / "AGENTS.md",
    # pi resolves its global layer from getAgentDir(), which is
    # $PI_AGENT_DIR or ~/.pi/agent -- not ~/.pi.
    "pi": HOME / ".pi" / "agent" / "AGENTS.md",
    # opencode reads ~/.config/opencode/AGENTS.md as its global layer.
    "opencode": HOME / ".config" / "opencode" / "AGENTS.md",
}

DRY = args.dry_run


def backup_existing(path: Path) -> None:
    if not (path.exists() or path.is_symlink()):
        return
    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
    backup = path.with_name(path.name + '.before-dotfiles-' + stamp)
    act(f'back up {path} -> {backup.name}')
    if not DRY:
        if path.is_symlink():
            backup.symlink_to(os.readlink(path))
        else:
            shutil.copy2(path, backup)


def act(msg: str) -> None:
    print(("  would " if DRY else "  ") + msg)


def install_claude() -> None:
    src_dir = BUILD / "claude" / "rules"
    dest_dir = TARGETS["claude"]
    if not dest_dir.exists():
        if not DRY:
            dest_dir.mkdir(parents=True)
    wanted = {p.name for p in src_dir.glob("*.md")}

    # Drop repo-managed links that are no longer built. Leave everything else.
    for existing in sorted(dest_dir.glob("*.md")):
        if not existing.is_symlink():
            continue
        target = os.path.realpath(existing)
        if not Path(target).is_relative_to(ROOT):
            continue  # machine-local or another repo's rule
        if existing.name not in wanted:
            act(f"unlink stale {existing.name}")
            if not DRY:
                existing.unlink()

    for src in sorted(src_dir.glob("*.md")):
        dest = dest_dir / src.name
        if dest.is_symlink() and Path(os.path.realpath(dest)) == src.resolve():
            continue
        act(f"link {src.name}")
        if dest.exists() or dest.is_symlink():
            backup_existing(dest)
        if not DRY:
            if dest.exists() or dest.is_symlink():
                dest.unlink()
            dest.symlink_to(src)


def install_single(agent: str) -> None:
    src = BUILD / agent / "AGENTS.md"
    dest = TARGETS[agent]
    if not src.exists():
        return
    if not dest.parent.exists():
        act(f"create {dest.parent}")
        if not DRY:
            dest.parent.mkdir(parents=True)
    text = src.read_text()
    if dest.exists() and dest.read_text() == text:
        return
    backup_existing(dest)
    act(f"write {dest}")
    if not DRY:
        if dest.is_symlink():
            dest.unlink()
        dest.write_text(text)


def main() -> int:
    if not BUILD.exists():
        sys.exit("error: build/ missing. Run bin/build first.")
    configured = tomllib.loads((ROOT.parent / 'setup.toml').read_text())['agents']
    for agent in args.agents or configured:
        print(f"{agent}:")
        if agent == 'claude':
            install_claude()
        else:
            install_single(agent)
    print("\ndry run, nothing changed." if DRY else "\ninstalled.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
