#!/usr/bin/env python3
"""Read current rule sources in build order, optionally as native hook context."""

import argparse
import json
from pathlib import Path
import runpy
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]
OPT_OUT = "dotfiles-rules: off"


def render_rules(agent: str) -> str:
    """Use the builder's selection and short-form resolution without writing build/."""
    builder = runpy.run_path(str(ROOT / "bin/build"))
    tiers = tomllib.loads((ROOT / "rules/tiers.toml").read_text())
    paths = builder["rules_for"](agent, tiers[agent])
    return f"Current dotfiles rules from {ROOT / 'rules'}:\n\n" + "\n\n".join(
        path.read_text().rstrip() for path in paths
    ) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--agent", choices=("codex", "claude", "grok", "pi", "opencode"), required=True)
    parser.add_argument("--hook", action="store_true", help="Read a native event from stdin")
    parser.add_argument("--text", action="store_true", help="Emit plain text instead of hook JSON")
    args = parser.parse_args()
    event = json.load(sys.stdin) if args.hook else {}
    if not isinstance(event, dict):
        raise ValueError('Hook event must be an object')
    prompt = event.get("prompt", "")
    if isinstance(prompt, str) and prompt.lstrip().split("\n", 1)[0].strip() == OPT_OUT:
        return 0
    text = render_rules(args.agent)
    if args.hook and not args.text:
        name = event.get('hook_event_name') or event.get('hookEventName', '')
        names = {'sessionstart': 'SessionStart', 'userpromptsubmit': 'UserPromptSubmit'}
        name = names[name.replace('_', '').lower()]
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": name, "additionalContext": text,
        }}))
    else:
        print(text, end="")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError) as exc:
        print(f"dotfiles-rules: cannot load current rules ({type(exc).__name__}); "
              "read ~/dotfiles/skills/rules/ before continuing.", file=sys.stderr)
        raise SystemExit(2)
