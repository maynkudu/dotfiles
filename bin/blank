#!/usr/bin/env python3
"""Use BLANK discovery, authenticated registry items, and inspiration access."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
ORIGIN = 'https://ui.aryank.space'
REGISTRY = {
    'url': ORIGIN + '/r/{name}.json',
    'headers': {'Authorization': 'Bearer ${BLANK_REGISTRY_TOKEN}'},
}


def credential(name):
    """Read the requested value without copying it into config or command arguments."""
    path = Path(os.environ.get('BLANK_KEYS_FILE', str(ROOT / 'kiys'))).expanduser()
    if path.stat().st_mode & 0o077:
        raise ValueError(f'Credentials must be owner-only. Run chmod 600 {path}.')
    aliases = {
        'registry_token': {'registry_token', 'blank_registry_token'},
        'passphrase': {'passphrase', 'passcode', 'inspiration_passphrase', 'inspiration_passcode'},
    }
    for line in path.read_text().splitlines():
        match = re.match(r'^\s*([^:=]+?)\s*[:=]\s*(.*?)\s*$', line)
        if not match:
            continue
        label = re.sub(r'[^a-z0-9]+', '_', match[1].lower()).strip('_')
        if label not in aliases[name]:
            continue
        value = match[2].strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in {'"', "'"}:
            value = value[1:-1]
        if not value or '\n' in value or '\r' in value:
            raise ValueError(f'Invalid {name} entry in {path}.')
        return value
    raise ValueError(f'Missing {name} entry in {path}.')


def fetch(path, authenticated=False):
    """Send registry authorization through stdin, keeping it out of process arguments."""
    command = ['curl', '--disable', '--proto', '=https', '--fail', '--silent',
               '--show-error', '--connect-timeout', '10', '--max-time', '30']
    headers = None
    if authenticated:
        command += ['--header', '@-']
        headers = 'Authorization: Bearer ' + credential('registry_token') + '\n'
    subprocess.run([*command, ORIGIN + path], input=headers, text=True, check=True)


def configure(project):
    """Merge the named registry into an existing shadcn project without storing a token."""
    path = project.resolve() / 'components.json'
    if not path.is_file():
        raise ValueError('No components.json. Initialize shadcn in the target app first.')
    config = json.loads(path.read_text())
    registries = config.setdefault('registries', {})
    current = registries.get('@compronents')
    if current == REGISTRY:
        print(f'Already configured: {path}')
        return
    if current is not None:
        raise ValueError('Existing @compronents configuration differs; inspect it before replacing it.')
    registries['@compronents'] = REGISTRY
    path.write_text(json.dumps(config, indent=2) + '\n')
    print(f'Configured @compronents in {path}')


def inspiration(session, headed):
    """Unlock the normal browser form in a caller-owned, nonpersistent session."""
    browser = ['agent-browser', '--session', session]
    launch = [*browser, *(['--headed'] if headed else []), 'open', ORIGIN + '/inspiration']
    subprocess.run(launch, check=True)
    snapshot = subprocess.run([*browser, 'snapshot', '-i'], capture_output=True,
                              text=True, check=True).stdout
    if 'textbox "Passphrase"' in snapshot:
        commands = [
            ['find', 'role', 'textbox', 'fill', credential('passphrase'), '--name', 'Passphrase', '--exact'],
            ['press', 'Enter'],
        ]
        result = subprocess.run([*browser, 'batch', '--bail', '--json'], input=json.dumps(commands),
                                capture_output=True, text=True, timeout=45)
        if result.returncode:
            raise ValueError('Browser login failed. No credentials or browser state were exported.')
    subprocess.run([*browser, 'wait', '--fn',
                    'document.querySelector("h1")?.textContent.trim() === "Inspiration"'], check=True)
    print(f'Inspiration is open in browser session {session}. Close that session when finished.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    search = commands.add_parser('search', help='Search public BLANK registry and inspiration references')
    search.add_argument('query', nargs='+')
    commands.add_parser('catalog', help='Read the authenticated registry catalog')
    source = commands.add_parser('source', help='Read an authenticated registry item and its source files')
    source.add_argument('name')
    project = commands.add_parser('configure', help='Add the registry to an existing shadcn project')
    project.add_argument('project', type=Path, nargs='?', default=Path.cwd())
    shadcn = commands.add_parser('shadcn', help='Run shadcn with the registry token in its process environment')
    shadcn.add_argument('arguments', nargs=argparse.REMAINDER)
    login = commands.add_parser('inspiration', help='Open and unlock the inspiration directory')
    login.add_argument('--session', required=True, help='Your isolated Agent Browser session name')
    login.add_argument('--headed', action='store_true', help='Show the browser window')
    args = parser.parse_args()

    if args.command == 'search':
        from urllib.parse import urlencode
        fetch('/direction?' + urlencode({'q': ' '.join(args.query)}))
    elif args.command == 'catalog':
        fetch('/r/registry.json', authenticated=True)
    elif args.command == 'source':
        if not re.fullmatch(r'[a-z0-9][a-z0-9-]*', args.name):
            raise ValueError('Use a registry item name, such as cell-portrait, rather than a URL.')
        fetch('/r/' + args.name + '.json', authenticated=True)
    elif args.command == 'configure':
        configure(args.project)
    elif args.command == 'shadcn':
        env = dict(os.environ, BLANK_REGISTRY_TOKEN=credential('registry_token'))
        os.execvpe('shadcn', ['shadcn', *args.arguments], env)
    else:
        inspiration(args.session, args.headed)


if __name__ == '__main__':
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(f'blank: command failed with status {error.returncode}.')
    except subprocess.TimeoutExpired:
        raise SystemExit('blank: browser operation timed out.')
    except (OSError, ValueError) as error:
        raise SystemExit(f'blank: {error}')
