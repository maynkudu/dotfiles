#!/usr/bin/env python3
"""Bounded configuration warnings. --hook always exits zero and never invokes tools."""
import argparse
import json
from pathlib import Path
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'skills/bin'))
from config_health import installed_health


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', type=Path, default=Path.home())
    parser.add_argument('--hook', action='store_true')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    try:
        cfg = tomllib.loads((ROOT / 'setup.toml').read_text())
        rows = installed_health(args.home.expanduser().resolve(), ROOT, cfg)
        failed = sum(row['status'] in ('failed', 'missing') for row in rows)
        unknown = sum(row['status'] == 'unknown' for row in rows)
        if args.json:
            print(json.dumps({'schema_version': 1, 'failed': failed, 'unknown': unknown, 'checks': rows}))
        elif failed or unknown:
            print(f'Dotfiles configuration: {failed} failed or missing; {unknown} unknown. Run python3 bin/doctor for details.')
        return 0 if args.hook else bool(failed)
    except (OSError, ValueError):
        print('Dotfiles configuration: unavailable. Inspect locally with bin/doctor.')
        return 0 if args.hook else 1


if __name__ == '__main__':
    raise SystemExit(main())
