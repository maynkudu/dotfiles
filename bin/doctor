#!/usr/bin/env python3
"""Report setup health without changing files, authenticating, or starting servers."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
cfg = tomllib.loads((ROOT / 'setup.toml').read_text())
search = str(Path.home() / '.local/bin') + os.pathsep + os.environ.get('PATH', '')
missing = []
paths = {}
for name in ['git', 'node', 'npm', 'pnpm', 'bun', 'uv', 'cargo', 'fnm', 'zsh', 'starship',
             'zoxide', 'rg', 'fd', 'bat', 'eza', 'ffmpeg', 'chromium', 'plannotator',
             'doc-python', 'blank', *cfg['agents'], *cfg['npm']]:
    path = shutil.which(name, path=search)
    paths[name] = path
    print(f"{'ok  ' if path else 'MISS'} {name}: {path or 'not on PATH'}", flush=True)
    if not path:
        missing.append(name)


def check_runtime(label, command):
    result = subprocess.run(command, capture_output=True, text=True, timeout=20)
    print(f"{'ok  ' if result.returncode == 0 else 'FAIL'} {label}", flush=True)
    if result.returncode:
        missing.append(label)
        print((result.stdout + result.stderr).strip()[:1600], flush=True)


if paths['doc-python']:
    check_runtime('document libraries and Pandoc', [paths['doc-python'], '-c',
        'import docx, pptx, openpyxl, pypdf, reportlab, PIL, pypandoc; pypandoc.get_pandoc_version()'])
if paths['node'] and paths.get('agentation-mcp'):
    check_runtime('Agentation SQLite storage', [paths['node'], '-e',
        'const req = require("node:module").createRequire(process.argv[1]); '
        'const db = new (req("better-sqlite3"))(":memory:"); '
        'db.prepare("SELECT 1").get(); db.close();',
        str(Path(paths['agentation-mcp']).resolve())])
if not shutil.which('soffice', path=search):
    print('WARN LibreOffice is missing. Office rendering and spreadsheet recalculation need libreoffice-fresh.', flush=True)
result = subprocess.run([sys.executable, ROOT / 'skills/bin/check'])
lock = json.loads((ROOT / 'skills/sources.lock.json').read_text())
print(f"\nOptional gaps: {len(lock['unavailable'])} old skill names absent from current upstreams;")
print('the original private design skill pack, legacy macOS Computer Use, and authenticated CPA pool are not configured.')
raise SystemExit(bool(missing or result.returncode))
