#!/usr/bin/env python3
"""Run explicit deterministic workflow fixtures. Never invoke a model or import transcripts."""

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from tools.workflow.private_state import WorkflowError
from tools.workflow.workflow_eval import run_workflow_fixtures


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--fixtures', type=Path, default=ROOT / 'tests/fixtures/workflow')
    args = parser.parse_args()
    report = run_workflow_fixtures(args.fixtures)
    print(json.dumps(report, indent=2))
    return 0 if report['passed'] == report['total'] else 1


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except WorkflowError as exc:
        print(f'{exc.code}: {exc}', file=sys.stderr)
        raise SystemExit(1)
