#!/usr/bin/env python3
"""Check this workflow's install and references. Startup warnings are bounded and non-blocking."""

import argparse
import json
from pathlib import Path
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from tools.workflow.workflow_health import workflow_health_report


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', type=Path, default=Path.home())
    parser.add_argument('--repo', type=Path, default=ROOT)
    parser.add_argument('--agents', nargs='+', choices=['codex', 'claude', 'pi', 'grok', 'opencode'])
    parser.add_argument('--repo-only', action='store_true')
    parser.add_argument('--startup', action='store_true', help='Warn once without blocking startup or reading hook payloads')
    args = parser.parse_args()
    try:
        agents = args.agents or tomllib.loads((args.repo / 'setup.toml').read_text())['agents']
        report = workflow_health_report(args.repo.resolve(), args.home.expanduser().resolve(), agents, repo_only=args.repo_only)
    except (OSError, ValueError, KeyError, TypeError):
        report = {'healthy': False, 'complete': False, 'findings': ['workflow configuration could not be read safely']}
    if args.startup:
        if report['findings']:
            print('Workflow setup needs review. Run agent-workflow-check for details.', file=sys.stderr)
        return 0
    print(json.dumps(report, indent=2))
    return 0 if report['healthy'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
